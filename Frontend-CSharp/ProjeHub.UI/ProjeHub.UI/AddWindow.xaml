<Window x:Class="ProjeHub.UI.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Bağlantı Ekle" Height="250" Width="450"
        Background="#0F0F0F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">

            <!-- Başlık -->
            <TextBlock Text="🔗 Yeni Bağlantı Ekle" 
                       Foreground="White" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,20" 
                       HorizontalAlignment="Center"/>

            <!-- Bilgi Metni -->
            <TextBlock Text="Proje veya Makale URL'si:" 
                       Foreground="#A0A0A0" 
                       FontSize="14" 
                       Margin="0,0,0,5"/>

            <!-- Link Giriş Kutusu (TextBox) -->
            <TextBox x:Name="txtUrl" 
                     Height="35" 
                     Background="#1A1A1A" 
                     Foreground="White" 
                     BorderBrush="#2D2D2D" 
                     BorderThickness="1" 
                     Padding="8,6,5,5" 
                     FontSize="14" 
                     Margin="0,0,0,20"/>

            <!-- Butonlar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- İptal Butonu -->
                <Button Content="İptal" 
                        Grid.Column="0" 
                        Margin="0,0,10,0" 
                        Height="35" 
                        Background="#2D2D2D" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand"/>

                <!-- Kaydet Butonu -->
                <Button Content="Kaydet" 
                        Grid.Column="1" 
                        Margin="10,0,0,0" 
                        Height="35" 
                        Background="#007ACC" 
                        Foreground="White" 
                        BorderThickness="0" 
                        FontWeight="Bold" 
                        Cursor="Hand"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>