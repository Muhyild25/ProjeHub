<Window x:Class="ProjeHub.UI.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Ekle" Height="650" Width="500"
        WindowStartupLocation="CenterScreen" Background="#0F0F0F" Foreground="White">

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="➕ Yeni Proje / Link Ekle" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Başlık:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBaslik" Height="35" Background="#1A1A1A" Foreground="White" BorderBrush="#2D2D2D" BorderThickness="1" Padding="10,5" Margin="0,0,0,15"/>

            <TextBlock Text="URL (Opsiyonel):" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUrl" Height="35" Background="#1A1A1A" Foreground="White" BorderBrush="#2D2D2D" BorderThickness="1" Padding="10,5" Margin="0,0,0,15"/>

            <TextBlock Text="Kategori:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbKategori" Height="35" Background="#1A1A1A" Foreground="Black" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Proje"/>
                <ComboBoxItem Content="Link"/>
                <ComboBoxItem Content="Genel"/>
                <ComboBoxItem Content="Eğitim"/>
            </ComboBox>

            <!-- YENİ EKLENEN: Notlar Kutusu -->
            <TextBlock Text="Notlar:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtNotlar" Height="120" Background="#1A1A1A" Foreground="White" BorderBrush="#2D2D2D" BorderThickness="1" Padding="10" Margin="0,0,0,25" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Height="40" Background="Transparent" Foreground="#A0A0A0" BorderThickness="1" BorderBrush="#2D2D2D" Margin="0,0,10,0" Cursor="Hand" Click="BtnIptal_Click"/>
                <Button Content="Ekle" x:Name="BtnEkle" Width="100" Height="40" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="BtnEkle_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>