<Window x:Class="ProjeHub.UI.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projeyi Düzenle" Height="650" Width="500"
        WindowStartupLocation="CenterScreen" Background="#0F0F0F" Foreground="White">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="✏️ Projeyi Düzenle" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Başlık Değiştirme Kutusu -->
            <TextBlock Text="Proje Başlığı:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBaslik" Height="35" Background="#1A1A1A" Foreground="White" BorderBrush="#2D2D2D" BorderThickness="1" Padding="10,5" Margin="0,0,0,15"/>

            <!-- Kategori Değiştirme Kutusu -->
            <TextBlock Text="Kategori:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbKategori" Height="35" Background="#1A1A1A" Foreground="Black" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,15">
                <ComboBoxItem Content="Proje"/>
                <ComboBoxItem Content="Link"/>
                <ComboBoxItem Content="Genel"/>
                <ComboBoxItem Content="Eğitim"/>
            </ComboBox>

            <!-- 🚥 YENİ EKLENEN: Durum Kutusu -->
            <TextBlock Text="Proje Durumu:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbDurum" Height="35" Background="#1A1A1A" Foreground="Black" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,15">
                <ComboBoxItem Content="Yapılacak"/>
                <ComboBoxItem Content="Devam Ediyor"/>
                <ComboBoxItem Content="Bitti"/>
            </ComboBox>

            <!-- Notlar Kutusu -->
            <TextBlock Text="Proje Notları:" Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtNotlar" Height="120" Background="#1A1A1A" Foreground="White" BorderBrush="#2D2D2D" BorderThickness="1" Padding="10" Margin="0,0,0,25" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <!-- Butonlar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Height="40" Background="Transparent" Foreground="#A0A0A0" BorderThickness="1" BorderBrush="#2D2D2D" Margin="0,0,10,0" Cursor="Hand" Click="BtnIptal_Click"/>
                <Button Content="Kaydet" x:Name="BtnKaydet" Width="100" Height="40" Background="#2EA043" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="BtnKaydet_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>